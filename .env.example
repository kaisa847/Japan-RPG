# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic API key used for scene generation. Without it the server still
# starts, but every scene returns a fallback "API key not configured" message.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# ─── Domain / CORS (set by deploy.sh) ───────────────────────────────────────
# Public domain the game is served from.
DOMAIN=game.example.com
# Allowed browser origin. If unset, cross-origin requests are blocked (the app
# is same-origin, so local development works without it). Set this in
# production so the login CSRF check uses the correct expected origin.
CORS_ORIGIN=https://game.example.com

# ─── Optional ───────────────────────────────────────────────────────────────
# Override the Claude model. If unset, a sensible default (FALLBACK_MODEL in
# backend/claude_handler.py) is used — you do NOT need to set this.
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Voice synthesis (edge-tts) is optional and enabled simply by installing
# backend/requirements-tts.txt; there is no env var to toggle it.
