[Unit]
Description=Japan-RPG Visual Novel Server
After=network.target
# Avoid rapid restart loops: at most 3 starts within 60s.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=jrpg
Group=jrpg
WorkingDirectory=/home/jrpg/Japan-RPG
EnvironmentFile=/home/jrpg/Japan-RPG/.env
ExecStart=/home/jrpg/Japan-RPG/venv/bin/gunicorn backend.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

# Hardening
ProtectSystem=strict
ReadWritePaths=/home/jrpg/Japan-RPG
PrivateTmp=true

[Install]
WantedBy=multi-user.target
