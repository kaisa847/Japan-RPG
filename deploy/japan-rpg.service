[Unit]
Description=Japan-RPG Visual Novel Server
After=network.target

[Service]
Type=exec
User=japan-rpg
Group=japan-rpg
WorkingDirectory=/opt/japan-rpg
EnvironmentFile=/opt/japan-rpg/.env
ExecStart=/opt/japan-rpg/venv/bin/gunicorn backend.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/japan-rpg/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
